<div class="nm-topo">
  <h3><i class="fa-solid fa-map"></i> {{localize "NM.Mapa.Titulo"}}</h3>
  <input type="search" name="filtro" placeholder="{{localize "NM.Mapa.Buscar"}}" value="{{filtro}}">
  <button type="button" class="nm-btn-topo" data-acao="novo-mapa"><i class="fa-solid fa-map"></i> {{localize "NM.Mapa.Criar"}}</button>
  <button type="button" class="nm-btn-topo" data-acao="nova-pasta"><i class="fa-solid fa-folder-plus"></i> {{localize "NM.Pasta.Criar"}}</button>
  <button type="button" class="nm-btn-topo" data-acao="recolher" data-tooltip="{{localize "NM.Pasta.RecolherTodas"}}"><i class="fa-solid fa-folder-tree"></i></button>
</div>

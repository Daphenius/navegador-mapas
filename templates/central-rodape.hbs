<footer class="nm-cc-rodape">
  <span class="nm-cc-estado {{#if pendentes}}pendente{{/if}}">{{#if pendentes}}<i class="fa-solid fa-circle"></i> {{textos.mudancas}}{{else}}<i class="fa-solid fa-check"></i> {{textos.semMudancas}}{{/if}}</span>
  <button type="button" data-action="cancelar" {{#if salvando}}disabled{{/if}}>{{textos.cancelar}}</button>
  <button type="button" class="nm-cc-salvar" data-action="salvar" {{#unless pendentes}}disabled{{/unless}} {{#if salvando}}disabled{{/if}}><i class="fa-solid {{#if salvando}}fa-spinner fa-spin{{else}}fa-floppy-disk{{/if}}"></i> {{textos.salvar}}</button>
</footer>
